# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.idea/
.vscode/
*.swp
*.swo
.pytest_cache/
pytest-cache*/
.ruff_cache/

# Environment and secrets (do not commit credentials)
.env
.env.*
*.key
*.pem
service-account*.json

# Data files (never commit raw data)
# keep the data folder in the python modules though since that's data code, not data itself
*.parquet
*.tsv
*.pkl
*.pickle
*.h5
*.hdf5
data/
!src/data/

# CSV files: ignore by default, but allow the audit-trail artifact
*.csv
!outputs/tables/eda_decisions.csv

# Outputs: ignore generated artifacts, but keep the directory structure
# and the committee-visible audit-trail CSV.
outputs/tables/*
outputs/figures/*
outputs/preprocessed/*
outputs/features/*
!outputs/.gitkeep
!outputs/tables/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/eda_decisions.csv

# Scratch: local notes only, not committed
scratch/
tmp/
temp/

# OS
.DS_Store
Thumbs.db

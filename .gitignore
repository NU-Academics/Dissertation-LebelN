# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment / secrets
.env
.env.*
*.key
*.pem
service-account*.json

# Data files — never commit raw data
*.parquet
*.csv
*.tsv
*.pkl
*.pickle
*.h5
*.hdf5
data/

# Outputs — generated artifacts (keep .gitkeep)
outputs/tables/*
outputs/figures/*
!outputs/.gitkeep
!outputs/tables/.gitkeep
!outputs/figures/.gitkeep

# OS
.DS_Store
Thumbs.db

# Scratch / temp
scratch/
tmp/
temp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.idea/
.vscode/
*.swp
*.swo
.pytest_cache/
pytest-cache*/
.ruff_cache/

# Environment and secrets (do not commit credentials)
.env
.env.*
*.key
*.pem
service-account*.json

# Data files (never commit raw data)
*.parquet
*.tsv
*.pkl
*.pickle
*.h5
*.hdf5
data/

# CSV files: ignore by default, but allow specific audit-trail artifacts
*.csv

# Outputs: ignore generated artifacts, but keep the directory structure
# (.gitkeep) and the explicit committee-visible artifacts.
outputs/tables/*
outputs/figures/*
!outputs/.gitkeep
!outputs/tables/.gitkeep
!outputs/figures/.gitkeep

# Scratch / temp: ignore by default
scratch/*
tmp/
temp/

# OS
.DS_Store
Thumbs.db
